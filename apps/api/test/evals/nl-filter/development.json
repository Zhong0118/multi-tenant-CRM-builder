[
  {
    "id": "D01",
    "category": "多条件、选项与金额",
    "text": "我负责的客户里，把处在报价或谈判阶段、预计金额超过十万元的挑出来。",
    "currentRule": {
      "version": 1,
      "match": "all",
      "conditions": []
