            "fieldKey": "$owner",
            "operator": "in",
            "value": ["$me"]
          },
          {
            "fieldKey": "stage",
            "operator": "in",
            "value": ["quote", "negotiation"]
          },
          {
            "fieldKey": "amount",
            "operator": "gt",
            "value": "100000"
          }
        ]
      }
    }
