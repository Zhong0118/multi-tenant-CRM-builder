# Copy to a secret manager or local ignored file; never commit real values.
NODE_ENV=production
PORT=3001
WEB_ORIGIN=https://app.example.invalid
API_ORIGIN=https://api.example.invalid
NEXT_PUBLIC_API_ORIGIN=https://api.example.invalid
PUBLIC_REGISTRATION_ENABLED=false
DATABASE_ADMIN_URL=postgresql://<migration-owner>:<password>@<db-host>:5432/<database>
DATABASE_URL=postgresql://<runtime-role>:<password>@<db-host>:5432/<database>
REDIS_URL=redis://:<password>@<redis-host>:6379
# AI is required for this internal trial. The API reads exactly these names.
AI_PROVIDER=openai
AI_MODEL=<approved-model>
AI_API_KEY=<secret-manager-reference>
AI_BASE_URL=
AI_TIMEOUT_MS=45000
ATTACHMENTS_STORAGE_DIR=/var/lib/crm/attachments
# Production SMS is currently not implemented/verified; do not claim SMS readiness.
# SMS_PROVIDER=tencent
# TENCENT_SMS_SECRET_ID=<secret-manager-reference>
# TENCENT_SMS_SECRET_KEY=<secret-manager-reference>
# TENCENT_SMS_SDK_APP_ID=<provider-value>
# TENCENT_SMS_SIGN_NAME=<provider-value>
# TENCENT_SMS_REGISTER_TEMPLATE_ID=<provider-value>
# TENCENT_SMS_RESET_TEMPLATE_ID=<provider-value>
# TENCENT_SMS_REGION=ap-guangzhou
# HEALTH_URL=https://api.example.invalid/health
# BACKUP_DIR=/secure/backup/path
# RELEASE_POINTER_FILE=/path/to/release-pointer
