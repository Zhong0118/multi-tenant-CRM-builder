# Local Compose template. Copy to ignored .env.internal-trial (chmod 600).
# All example passwords/keys are placeholders; replace before any startup.
# Use URL-safe random passwords (e.g. openssl rand -hex 32), or URL-encode them in URLs.
RELEASE_ID=internal-trial
NODE_ENV=production
PORT=3001
# Web runs on its own container PORT=3000; API PORT never leaks into Web.
WEB_HOST=app.example.invalid
API_HOST=api.example.invalid
WEB_ORIGIN=https://app.example.invalid
API_ORIGIN=https://api.example.invalid
# Embedded in the browser bundle by Docker build; rebuild when this changes.
NEXT_PUBLIC_API_ORIGIN=https://api.example.invalid
PUBLIC_REGISTRATION_ENABLED=false
# Normalized +86 phones, comma-separated; temporary platform bootstrap allowlist.
FIRST_ADMIN_PHONE=
POSTGRES_DB=crm
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=replace-with-unique-owner-password
CRM_APP_PASSWORD=replace-with-unique-runtime-password
DATABASE_ADMIN_URL=postgresql://crm_owner:replace-with-unique-owner-password@postgres:5432/crm
DATABASE_URL=postgresql://crm_app:replace-with-unique-runtime-password@postgres:5432/crm
REDIS_PASSWORD=replace-with-unique-redis-password
REDIS_URL=redis://:replace-with-unique-redis-password@redis:6379
# Required internal-trial AI configuration; actual secrets, not references, reach the container.
AI_PROVIDER=openai
AI_MODEL=replace-with-approved-model
AI_API_KEY=replace-with-secret-manager-injected-key
AI_BASE_URL=
AI_TIMEOUT_MS=45000
# Compose fixes this path and mounts attachments_data here.
ATTACHMENTS_STORAGE_DIR=/var/lib/crm/attachments
# Production SMS is not implemented/verified; registration bootstrap is blocked until supported.
# Do not set DEV_VERIFICATION_CODE in production.
HEALTH_URL=https://api.example.invalid/api/v1/health
# Host backup/restore tools need owner/backup URLs reachable from the host;
# Compose postgres hostname is only resolvable inside its network.
# DATABASE_BACKUP_URL=postgresql://<backup-owner>:<encoded-password>@<reachable-host>:5432/crm
# BACKUP_DIR=/secure/backup/path
# RELEASE_POINTER_FILE=/path/to/release-pointer
