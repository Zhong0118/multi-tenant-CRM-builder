generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  TENANT_ADMIN
  EMPLOYEE
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_PHONE
}

enum ChallengeStatus {
  PENDING
  CONSUMED
  EXPIRED
  LOCKED
}

enum ObjectKind {
  GENERIC
  LEAD
  OPPORTUNITY
  CUSTOMER
  JOURNAL
}

enum ObjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  PHONE
  EMAIL
  NUMBER
  MONEY
  DATE
  DATETIME
  SINGLE_SELECT
  MULTI_SELECT
  MEMBER
  BOOLEAN
  ATTACHMENT
}

enum FieldStatus {
  ACTIVE
  INACTIVE
}

enum ViewType {
  TABLE
}

enum ViewStatus {
  ACTIVE
  INACTIVE
}

enum PermissionSubjectType {
  ROLE
  MEMBER
}

enum DataScope {
  ALL
  OWN
  NONE
}

enum FieldAccess {
  EDIT
  READ_ONLY
  HIDDEN
}

enum RecordSource {
  MANUAL
  IMPORT
  FEISHU
  PHONE_BOT
  API
}

enum RecordActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  STATUS_CHANGE
  SYSTEM
}

enum AuditActorType {
  USER
  INTEGRATION
  SYSTEM
}

enum DashboardStatus {
  ACTIVE
  ARCHIVED
}

enum DashboardAudience {
  ALL
  TENANT_ADMIN
  EMPLOYEE
}

model User {
  id                  String             @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  displayName         String             @map("display_name") @db.VarChar(100)
  email               String?            @unique @db.VarChar(320)
  phone               String             @unique @db.VarChar(32)
  phoneVerifiedAt     DateTime           @map("phone_verified_at") @db.Timestamptz(3)
  passwordHash        String             @map("password_hash")
  isPlatformAdmin     Boolean            @default(false) @map("is_platform_admin")
  status              UserStatus         @default(ACTIVE)
  lastLoginAt         DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  members             TenantMember[]
  sessions            Session[]
  targetInvitations   TenantInvitation[] @relation("InvitationTargetUser")
  createdInvitations  TenantInvitation[] @relation("InvitationCreatedBy")
  acceptedInvitations TenantInvitation[] @relation("InvitationAcceptedBy")
  createdTemplates    BusinessTemplate[] @relation("BusinessTemplateCreator")
  publishedTemplates  BusinessTemplateVersion[] @relation("BusinessTemplateVersionPublisher")
  appliedTemplates    BusinessTemplateApplication[] @relation("BusinessTemplateApplicationApplier")

  @@map("users")
}

model Tenant {
  id                 String              @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  name               String              @db.VarChar(200)
  code               String              @unique @db.VarChar(64)
  status             TenantStatus        @default(DRAFT)
  timezone           String              @default("Asia/Shanghai") @db.VarChar(64)
  locale             String              @default("zh-CN") @db.VarChar(16)
  settings           Json                @default("{}") @db.JsonB
  activatedAt        DateTime?           @map("activated_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  members            TenantMember[]
  invitations        TenantInvitation[]
  objects            ObjectDefinition[]
  fields             FieldDefinition[]
  records            Record[]
  recordActivities   RecordActivity[]
  followUps          RecordFollowUp[]
  objectPublications ObjectPublication[]
  views              ViewDefinition[]
  objectPermissions  ObjectPermission[]
  fieldPermissions   FieldPermission[]
  recordCounters     RecordCounter[]
  templateApplications BusinessTemplateApplication[]
  dashboardConfigurations TenantDashboardConfiguration[]
  dashboardPublications TenantDashboardPublication[]
  defaultAdminDashboardId String? @map("default_admin_dashboard_id") @db.Uuid
  defaultEmployeeDashboardId String? @map("default_employee_dashboard_id") @db.Uuid
  defaultAdminDashboard TenantDashboardConfiguration? @relation("DefaultAdminDashboard", fields: [id, defaultAdminDashboardId], references: [tenantId, id], onDelete: Restrict)
  defaultEmployeeDashboard TenantDashboardConfiguration? @relation("DefaultEmployeeDashboard", fields: [id, defaultEmployeeDashboardId], references: [tenantId, id], onDelete: Restrict)

  @@map("tenants")
}

model TenantDashboardConfiguration {
  id                      String                       @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId                String                       @map("tenant_id") @db.Uuid
  code                    String                       @db.VarChar(64)
  name                    String                       @db.VarChar(100)
  status                  DashboardStatus              @default(ACTIVE)
  audience                DashboardAudience            @default(ALL)
  sortOrder               Int                          @default(0) @map("sort_order")
  draftVersion            Int                          @default(1) @map("version")
  draftConfiguration      Json                         @map("configuration") @db.JsonB
  activePublicationId     String?                      @map("active_publication_id") @db.Uuid
  sourceTemplateVersionId String?                      @map("source_template_version_id") @db.Uuid
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplateVersion   BusinessTemplateVersion?     @relation(fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  publications            TenantDashboardPublication[] @relation("TenantDashboardPublications")
  activePublication       TenantDashboardPublication?  @relation("ActiveTenantDashboardPublication", fields: [tenantId, activePublicationId], references: [tenantId, id], onDelete: Restrict)
  defaultAdminFor         Tenant[]                     @relation("DefaultAdminDashboard")
  defaultEmployeeFor      Tenant[]                     @relation("DefaultEmployeeDashboard")

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, activePublicationId])
  @@index([tenantId, status, sortOrder])
  @@map("tenant_dashboard_configurations")
}

model TenantDashboardPublication {
  id                  String                        @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId            String                        @map("tenant_id") @db.Uuid
  dashboardId         String                        @map("dashboard_id") @db.Uuid
  publicationNo       Int                           @map("publication_no")
  sourceDraftVersion  Int                           @map("source_draft_version")
  configuration       Json                          @db.JsonB
  publishedByMemberId String?                       @map("published_by_member_id") @db.Uuid
  publishedAt         DateTime                      @default(now()) @map("published_at") @db.Timestamptz(3)
  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition          TenantDashboardConfiguration  @relation("TenantDashboardPublications", fields: [tenantId, dashboardId], references: [tenantId, id], onDelete: Restrict, map: "tenant_dashboard_publications_tenant_id_definition_fkey")
  publisher           TenantMember?                 @relation("TenantDashboardPublicationPublisher", fields: [tenantId, publishedByMemberId], references: [tenantId, id], onDelete: Restrict)
  activeFor           TenantDashboardConfiguration? @relation("ActiveTenantDashboardPublication")

  @@unique([dashboardId, publicationNo])
  @@unique([tenantId, id])
  @@index([tenantId, dashboardId, publishedAt(sort: Desc)])
  @@map("tenant_dashboard_publications")
}

model TenantMember {
  id                        String              @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId                  String              @map("tenant_id") @db.Uuid
  userId                    String              @map("user_id") @db.Uuid
  role                      MemberRole
  status                    MemberStatus        @default(ACTIVE)
  employeeNo                String?             @map("employee_no") @db.VarChar(64)
  joinedAt                  DateTime?           @map("joined_at") @db.Timestamptz(3)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  ownedRecords              Record[]            @relation("RecordOwner")
  createdRecords            Record[]            @relation("RecordCreator")
  recordActivities          RecordActivity[]    @relation("RecordActivityActor")
  followUps                 RecordFollowUp[]
  publishedObjects          ObjectPublication[] @relation("ObjectPublicationPublisher")
  publishedDashboards       TenantDashboardPublication[] @relation("TenantDashboardPublicationPublisher")
  objectPermissionOverrides ObjectPermission[]  @relation("ObjectPermissionMember")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@unique([tenantId, employeeNo])
  @@index([tenantId, status])
  @@map("tenant_members")
}

model TenantInvitation {
  id                  String           @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  targetPhone         String           @map("target_phone") @db.VarChar(32)
  targetUserId        String?          @map("target_user_id") @db.Uuid
  role                MemberRole
  permissionOverrides Json?            @map("permission_overrides") @db.JsonB
  invitationCodeHash  String           @map("invitation_code_hash")
  status              InvitationStatus @default(PENDING)
  createdByUserId     String           @map("created_by_user_id") @db.Uuid
  expiresAt           DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedByUserId    String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt          DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  targetUser          User?            @relation("InvitationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdBy           User             @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy          User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, targetPhone, status])
  @@index([targetUserId, status])
  @@map("tenant_invitations")
}

model VerificationChallenge {
  id           String              @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  phone        String              @db.VarChar(32)
  purpose      VerificationPurpose
  codeHash     String              @map("code_hash")
  status       ChallengeStatus     @default(PENDING)
  attemptCount Int                 @default(0) @map("attempt_count") @db.SmallInt
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz(3)
  requestIp    String              @map("request_ip") @db.Inet
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, purpose, createdAt(sort: Desc)])
  @@map("verification_challenges")
}

model Session {
  id            String    @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  ip            String?   @db.Inet
  deviceSummary String?   @map("device_summary") @db.VarChar(300)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model ObjectDefinition {
  id                      String              @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId                String              @map("tenant_id") @db.Uuid
  name                    String              @db.VarChar(100)
  code                    String              @db.VarChar(64)
  kind                    ObjectKind          @default(GENERIC)
  titleFieldKey           String              @map("title_field_key") @db.VarChar(64)
  icon                    String?             @db.VarChar(64)
  status                  ObjectStatus        @default(DRAFT)
  sortOrder               Int                 @default(0) @map("sort_order")
  settings                Json                @default("{}") @db.JsonB
  sourceTemplateVersionId String?             @map("source_template_version_id") @db.Uuid
  activePublicationId     String?             @map("active_publication_id") @db.Uuid
  publishedAt             DateTime?           @map("published_at") @db.Timestamptz(3)
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?           @map("deleted_at") @db.Timestamptz(3)
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplateVersion   BusinessTemplateVersion? @relation(fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  fields                  FieldDefinition[]
  records                 Record[]
  publications            ObjectPublication[] @relation("ObjectPublications")
  activePublication       ObjectPublication?  @relation("ActiveObjectPublication", fields: [tenantId, activePublicationId], references: [tenantId, id], onDelete: Restrict)
  views                   ViewDefinition[]
  permissions             ObjectPermission[]
  fieldPermissions        FieldPermission[]
  recordCounter           RecordCounter?

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, activePublicationId])
  @@index([tenantId, status, sortOrder])
  @@map("object_definitions")
}

model BusinessTemplate {
  id                 String                    @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  code               String                    @unique @db.VarChar(64)
  name               String                    @db.VarChar(100)
  description        String?                   @db.VarChar(1000)
  draftVersion       Int                       @default(1) @map("draft_version")
  draftConfiguration Json                      @map("draft_configuration") @db.JsonB
  activeVersionId    String?                   @unique @map("active_version_id") @db.Uuid
  publishedAt        DateTime?                 @map("published_at") @db.Timestamptz(3)
  createdByUserId    String                    @map("created_by_user_id") @db.Uuid
  archivedAt         DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions           BusinessTemplateVersion[] @relation("BusinessTemplateVersions")
  activeVersion      BusinessTemplateVersion?  @relation("ActiveBusinessTemplateVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  creator            User                      @relation("BusinessTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("business_templates")
}

model BusinessTemplateVersion {
  id                    String                        @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  templateId            String                        @map("template_id") @db.Uuid
  versionNo             Int                           @map("version_no")
  sourceDraftVersion    Int                           @map("source_draft_version")
  schemaVersion         Int                           @map("schema_version")
  configuration         Json                          @db.JsonB
  configurationChecksum String                        @map("configuration_checksum") @db.Char(64)
  changeSummary         Json                          @map("change_summary") @db.JsonB
  publishedByUserId     String                        @map("published_by_user_id") @db.Uuid
  publishedAt           DateTime                      @default(now()) @map("published_at") @db.Timestamptz(3)
  template              BusinessTemplate              @relation("BusinessTemplateVersions", fields: [templateId], references: [id], onDelete: Restrict)
  activeForTemplate     BusinessTemplate?             @relation("ActiveBusinessTemplateVersion")
  publisher             User                          @relation("BusinessTemplateVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  applications          BusinessTemplateApplication[]
  sourceObjects         ObjectDefinition[]
  sourceDashboards      TenantDashboardConfiguration[]

  @@unique([templateId, versionNo])
  @@unique([templateId, sourceDraftVersion])
  @@map("business_template_versions")
}

model BusinessTemplateApplication {
  id                    String                  @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  templateVersionId     String                  @map("template_version_id") @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  appliedByUserId       String                  @map("applied_by_user_id") @db.Uuid
  configurationChecksum String                  @map("configuration_checksum") @db.Char(64)
  objectIdMap           Json                    @map("object_id_map") @db.JsonB
  appliedAt             DateTime                @default(now()) @map("applied_at") @db.Timestamptz(3)
  templateVersion       BusinessTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appliedBy             User                    @relation("BusinessTemplateApplicationApplier", fields: [appliedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, templateVersionId])
  @@map("business_template_applications")
}

model FieldDefinition {
  id           String            @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  objectId     String            @map("object_id") @db.Uuid
  fieldKey     String            @map("field_key") @db.VarChar(64)
  label        String            @db.VarChar(100)
  type         FieldType
  required     Boolean           @default(false)
  isSystem     Boolean           @default(false) @map("is_system")
  isSensitive  Boolean           @default(false) @map("is_sensitive")
  defaultValue Json?             @map("default_value") @db.JsonB
  validation   Json              @default("{}") @db.JsonB
  config       Json              @default("{}") @db.JsonB
  sortOrder    Int               @default(0) @map("sort_order")
  status       FieldStatus       @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object       ObjectDefinition  @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)
  permissions  FieldPermission[]

  @@unique([tenantId, objectId, fieldKey])
  @@unique([tenantId, objectId, id])
  @@index([tenantId, objectId, status, sortOrder])
  @@map("field_definitions")
}

model ObjectPublication {
  id                  String            @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  objectId            String            @map("object_id") @db.Uuid
  publicationNo       Int               @map("publication_no")
  sourceDraftVersion  Int               @map("source_draft_version")
  configuration       Json              @db.JsonB
  changeSummary       Json              @map("change_summary") @db.JsonB
  publishedByMemberId String            @map("published_by_member_id") @db.Uuid
  publishedAt         DateTime          @default(now()) @map("published_at") @db.Timestamptz(3)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object              ObjectDefinition  @relation("ObjectPublications", fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)
  publisher           TenantMember      @relation("ObjectPublicationPublisher", fields: [tenantId, publishedByMemberId], references: [tenantId, id], onDelete: Restrict)
  activeFor           ObjectDefinition? @relation("ActiveObjectPublication")

  @@unique([tenantId, objectId, publicationNo])
  @@unique([tenantId, id])
  @@index([tenantId, objectId, publishedAt(sort: Desc)])
  @@map("object_publications")
}

model ViewDefinition {
  id              String           @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  objectId        String           @map("object_id") @db.Uuid
  code            String           @db.VarChar(64)
  name            String           @db.VarChar(100)
  type            ViewType         @default(TABLE)
  columnFieldKeys Json             @map("column_field_keys") @db.JsonB
  sort            Json             @db.JsonB
  status          ViewStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object          ObjectDefinition @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, objectId, code])
  @@index([tenantId, objectId, status])
  @@map("view_definitions")
}

model ObjectPermission {
  id              String                @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  objectId        String                @map("object_id") @db.Uuid
  subjectType     PermissionSubjectType @map("subject_type")
  subjectRole     MemberRole?           @map("subject_role")
  subjectMemberId String?               @map("subject_member_id") @db.Uuid
  canCreate       Boolean               @default(false) @map("can_create")
  canRead         Boolean               @default(false) @map("can_read")
  canUpdate       Boolean               @default(false) @map("can_update")
  canDelete       Boolean               @default(false) @map("can_delete")
  readScope       DataScope             @default(NONE) @map("read_scope")
  updateScope     DataScope             @default(NONE) @map("update_scope")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object          ObjectDefinition      @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)
  subjectMember   TenantMember?         @relation("ObjectPermissionMember", fields: [tenantId, subjectMemberId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, objectId, subjectType])
  @@map("object_permissions")
}

model FieldPermission {
  id          String           @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  objectId    String           @map("object_id") @db.Uuid
  fieldId     String           @map("field_id") @db.Uuid
  subjectRole MemberRole       @map("subject_role")
  access      FieldAccess
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object      ObjectDefinition @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)
  field       FieldDefinition  @relation(fields: [tenantId, objectId, fieldId], references: [tenantId, objectId, id], onDelete: Restrict)

  @@unique([tenantId, fieldId, subjectRole])
  @@index([tenantId, objectId, subjectRole])
  @@map("field_permissions")
}

model RecordCounter {
  tenantId     String           @map("tenant_id") @db.Uuid
  objectId     String           @map("object_id") @db.Uuid
  nextRecordNo BigInt           @default(1) @map("next_record_no")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object       ObjectDefinition @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, objectId])
  @@map("record_counters")
}

model Record {
  id                     String           @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  objectId               String           @map("object_id") @db.Uuid
  recordNo               BigInt           @map("record_no")
  ownerMemberId          String?          @map("owner_member_id") @db.Uuid
  statusKey              String?          @map("status_key") @db.VarChar(64)
  title                  String           @db.VarChar(300)
  data                   Json             @default("{}") @db.JsonB
  source                 RecordSource     @default(MANUAL)
  createdByMemberId      String?          @map("created_by_member_id") @db.Uuid
  createdByIntegrationId String?          @map("created_by_integration_id") @db.Uuid
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz(3)
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  object                 ObjectDefinition @relation(fields: [tenantId, objectId], references: [tenantId, id], onDelete: Restrict)
  owner                  TenantMember?    @relation("RecordOwner", fields: [tenantId, ownerMemberId], references: [tenantId, id], onDelete: Restrict)
  createdBy              TenantMember?    @relation("RecordCreator", fields: [tenantId, createdByMemberId], references: [tenantId, id], onDelete: Restrict)
  activities             RecordActivity[]
  followUps              RecordFollowUp[]

  @@unique([tenantId, id])
  @@unique([tenantId, objectId, recordNo])
  @@index([tenantId, objectId, deletedAt, updatedAt(sort: Desc)])
  @@index([tenantId, objectId, ownerMemberId, deletedAt, updatedAt(sort: Desc)])
  @@index([tenantId, objectId, statusKey, deletedAt])
  @@map("records")
}

model RecordActivity {
  id                  String             @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  recordId            String             @map("record_id") @db.Uuid
  activityType        RecordActivityType @map("activity_type")
  content             String
  resultKey           String?            @map("result_key") @db.VarChar(64)
  nextActionAt        DateTime?          @map("next_action_at") @db.Timestamptz(3)
  actorMemberId       String?            @map("actor_member_id") @db.Uuid
  actorIntegrationId  String?            @map("actor_integration_id") @db.Uuid
  metadata            Json               @default("{}") @db.JsonB
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  record              Record             @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: Restrict)
  actor               TenantMember?      @relation("RecordActivityActor", fields: [tenantId, actorMemberId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, recordId, createdAt(sort: Desc)])
  @@map("record_activities")
}

model AuditLog {
  id           String         @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String         @db.VarChar(100)
  resourceType String         @map("resource_type") @db.VarChar(100)
  resourceId   String?        @map("resource_id") @db.Uuid
  before       Json?          @db.JsonB
  after        Json?          @db.JsonB
  reason       String?
  requestId    String         @map("request_id") @db.VarChar(100)
  ip           String?        @db.Inet
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}


model RecordFollowUp {
  id String @id @default(dbgenerated("crm_uuid_v7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  recordId String @map("record_id") @db.Uuid
  assigneeMemberId String @map("assignee_member_id") @db.Uuid
  title String @db.VarChar(200)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  status String @default("OPEN") @db.VarChar(16)
  version Int @default(1)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  record Record @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: Restrict)
  assignee TenantMember @relation(fields: [tenantId, assigneeMemberId], references: [tenantId, id], onDelete: Restrict)
  @@index([tenantId, assigneeMemberId, status, dueAt])
  @@map("record_follow_ups")
}
