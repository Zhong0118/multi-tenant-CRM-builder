  revisionId String @map("revision_id") @db.Uuid
  credentialId String @map("credential_id") @db.Uuid
  modelName String @map("model_name")
  purpose String
  suite String
  actorId String @map("actor_id") @db.Uuid
  startedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  status String @default("running")
  steps Json @default("[]")
  durationMs Int? @map("duration_ms")
  errorCode String? @map("error_code")
  dimensions Int?
  inputTokens BigInt @default(0) @map("input_tokens")
  outputTokens BigInt @default(0) @map("output_tokens")
  actor User @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revision AiModelRevision @relation(fields: [revisionId, credentialId], references: [id, credentialId], onDelete: Cascade, onUpdate: NoAction)
  model AiConfigModel @relation(fields: [revisionId, modelName], references: [revisionId, name], onDelete: Cascade, onUpdate: NoAction)
  @@map("ai_model_tests")
}

model AiModelAssignment {
  purpose String @id
  scope String @default("platform")
  planId String? @map("plan_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  modelName String @map("model_name")
  version Int
  dimensions Int?
  revision AiModelRevision @relation(fields: [providerId, revisionId], references: [providerId, id], onDelete: NoAction, onUpdate: NoAction)
  model AiConfigModel @relation(fields: [revisionId, modelName], references: [revisionId, name], onDelete: NoAction, onUpdate: NoAction)
  @@map("ai_model_assignments")
}

model AiFeatureCatalog {
  key String @id
  label String
  groupLabel String @map("group_label")
  position Int @unique
  purpose String
  requiresKey String? @map("requires_key")
  released Boolean
  outputLimit Int? @map("output_limit")
  dependency AiFeatureCatalog? @relation("AiFeatureDependencies", fields: [requiresKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  dependents AiFeatureCatalog[] @relation("AiFeatureDependencies")
  calls AiModelCall[]
  @@map("ai_feature_catalog")
}

model EmailChallenge {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      String    @db.VarChar(12)
  emailDigest  String    @map("email_digest") @db.Char(64)
  emailVersion Int       @map("email_version")
  codeHash     String    @map("code_hash") @db.Char(64)
  status       String    @db.VarChar(12)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([userId, purpose, emailDigest], map: "email_challenges_owner_target_idx")
  @@index([expiresAt])
  @@map("email_challenges")
}

model LoginDevice {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash") @db.Char(64)
  device     String?  @db.VarChar(64)
  network    String?  @db.VarChar(64)
  lastUsedAt DateTime @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([userId, tokenHash])
  @@index([userId, lastUsedAt], map: "login_devices_last_used_at_idx")
  @@map("login_devices")
}
