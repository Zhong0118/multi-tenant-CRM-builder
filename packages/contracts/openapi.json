          },
          "targetUserId": {
            "format": "uuid",
            "type": "string"
          },
          "tenantCode": {
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenantId",
          "targetPhone",
          "role",
          "status",
          "expiresAt"
