      "TenantMemberResponseDto": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "phone": {
            "example": "+8613800138000",
            "type": "string"
          },
          "role": {
            "enum": ["TENANT_ADMIN", "EMPLOYEE"],
            "type": "string"
          },
          "status": {
            "enum": ["ACTIVE", "DISABLED"],
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id", "userId", "tenantId", "role", "status"],
        "type": "object"
      },
      "UserResponseDto": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isPlatformAdmin": {
            "type": "boolean"
          },
          "phone": {
            "example": "+8613800138000",
            "type": "string"
          }
        },
        "required": ["id", "displayName", "phone", "isPlatformAdmin"],
