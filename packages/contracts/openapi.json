    "schemas": {
      "AcceptedResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": ["accepted"],
        "type": "object"
      },
      "AuthenticatedResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": ["accepted", "user"],
        "type": "object"
      },
      "ChangeMemberStatusDto": {
        "properties": {
          "status": {
            "enum": ["ACTIVE", "DISABLED"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 200,
            "type": "string"
          },
          "newPassword": {
            "format": "password",
            "maxLength": 72,
            "minLength": 10,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[\\s\\S]*$",
            "type": "string"
          }
        },
        "required": ["currentPassword", "newPassword"],
        "type": "object"
      },
      "ChangeTenantStatusDto": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "type": "string"
          },
          "status": {
            "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "CLOSED"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "CreateInvitationDto": {
        "properties": {
          "phone": {
            "example": "13800138000",
            "type": "string"
          },
          "role": {
            "enum": ["TENANT_ADMIN", "EMPLOYEE"],
            "type": "string"
          }
        },
        "required": ["phone", "role"],
        "type": "object"
      },
      "CreatePlatformTenantDto": {
        "properties": {
          "code": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "firstAdminPhone": {
            "example": "13800138000",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "code", "firstAdminPhone"],
        "type": "object"
      },
      "CreatedInvitationResponseDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": ["PENDING"],
            "type": "string"
          }
        },
        "required": ["id", "status"],
        "type": "object"
      },
      "FirstAdminInvitationResponseDto": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["TENANT_ADMIN"],
            "type": "string"
          },
          "status": {
            "enum": ["PENDING", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"],
            "type": "string"
          },
          "targetPhone": {
            "example": "+8613800138000",
            "type": "string"
          }
        },
        "required": ["id", "targetPhone", "role", "status", "expiresAt"],
        "type": "object"
      },
      "ForgotPasswordDto": {
        "properties": {
          "deviceKey": {
            "maxLength": 200,
            "minLength": 8,
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          }
        },
        "required": ["phone", "deviceKey"],
        "type": "object"
      },
      "InvitationActionResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": ["accepted"],
        "type": "object"
      },
      "InvitationMembershipResponseDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["TENANT_ADMIN", "EMPLOYEE"],
            "type": "string"
          },
          "status": {
            "enum": ["ACTIVE", "DISABLED"],
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id", "tenantId", "userId", "role", "status"],
        "type": "object"
      },
      "InvitationPageResponseDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TenantInvitationResponseDto"
            },
            "type": "array"
          },
          "nextCursor": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["items"],
        "type": "object"
