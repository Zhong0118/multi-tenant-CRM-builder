      "InvitationResentResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["accepted", "expiresAt"],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
