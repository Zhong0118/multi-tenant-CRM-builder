            "maxLength": 200,
            "minLength": 8,
            "type": "string"
          },
          "deviceSummary": {
            "maxLength": 300,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 200,
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          }
        },
        "required": ["phone", "password", "deviceKey", "deviceSummary"],
        "type": "object"
      },
      "MembershipActionResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": ["accepted"],
        "type": "object"
      },
      "PersonalInvitationResponseDto": {
        "properties": {
          "acceptedByUserId": {
            "format": "uuid",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["TENANT_ADMIN", "EMPLOYEE"],
            "type": "string"
          },
          "status": {
            "enum": ["PENDING", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"],
