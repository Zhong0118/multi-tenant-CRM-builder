          }
        },
        "required": ["phone", "purpose", "deviceKey"],
        "type": "object"
      },
      "WorkspaceSummaryResponseDto": {
        "properties": {
          "memberId": {
            "format": "uuid",
            "type": "string"
          },
          "memberStatus": {
            "enum": ["ACTIVE", "DISABLED"],
