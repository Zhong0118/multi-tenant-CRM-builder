          },
          "role": {
            "enum": ["TENANT_ADMIN", "EMPLOYEE"],
            "type": "string"
          },
          "tenantCode": {
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "tenantStatus": {
            "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "CLOSED"],
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "tenantCode",
          "tenantName",
          "tenantStatus",
          "memberId",
          "memberStatus",
          "role"
        ],
        "type": "object"
      }
