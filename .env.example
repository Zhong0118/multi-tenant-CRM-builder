DATABASE_ADMIN_URL=postgresql://crm:crm@localhost:5432/crm
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5432/crm
TEST_DATABASE_ADMIN_URL=postgresql://crm:crm@localhost:5433/crm_test
TEST_DATABASE_URL=postgresql://crm_app:crm_app@localhost:5433/crm_test
REDIS_URL=redis://localhost:6379
PORT=3001
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
API_ORIGIN=http://localhost:3001
NODE_ENV=development
DEV_VERIFICATION_CODE=123456

# Production only: all Tencent values are required when SMS_PROVIDER=tencent.
# SMS_PROVIDER=tencent
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_REGISTER_TEMPLATE_ID=
# TENCENT_SMS_RESET_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=45000

# Telephone integration: 32 stable random bytes encoded as 64 hexadecimal characters.
# Required before saving encrypted provider/callback credentials. Never rotate without re-encrypting saved values.
TELEPHONY_ENCRYPTION_KEY=
# Local MOCK only by default. Production forbids MOCK. Do not enable until supplier protocol/auth is verified.
TELEPHONY_LIVE_ENABLED=false
